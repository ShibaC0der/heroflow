# Можно задать здесь или в ~/.heroflow/config.yaml (секции bitbucket / jira / gigacode / http)
BB_TOKEN=
BB_URL=
BB_PROJECT=
BB_REPO_SLUG=
# Чьи /hf-комментарии в PR брать в работу, JSON-список. Пусто = всех
# BB_ALLOWED_COMMENT_AUTHORS=["alex"]

JIRA_TOKEN=
JIRA_URL=
# JIRA_EPIC_FIELD=customfield_11400

GG_FAST_MODEL=
GG_REASONING_MODEL=
# GG_EXECUTABLE=gigacode

# Корпоративный CA вместо отключения проверки TLS
# HTTP_CA_BUNDLE=/path/to/ca.pem
# Старое поведение verify=False, только осознанно
# HTTP_INSECURE=true
